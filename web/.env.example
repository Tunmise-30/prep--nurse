# Copy to .env.local and fill with YOUR Paystack TEST keys (never real/live keys here).
# Get them free at https://dashboard.paystack.com → Settings → API Keys (use TEST mode).
# .env.local is ignored by git — secrets never enter the repo.

# Public key: safe for the browser (starts with pk_test_)
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Secret key: server only, NEVER share or commit (starts with sk_test_)
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
